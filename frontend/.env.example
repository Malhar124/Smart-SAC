# Backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1
# The SAC's time zone; must match APP_TIMEZONE on the backend
VITE_APP_TIMEZONE=Asia/Kolkata
# Optional: report frontend errors to Sentry
VITE_SENTRY_DSN=
# Where the app is served, for link previews (og:image). On Vercel the production URL is used if unset.
VITE_SITE_URL=
