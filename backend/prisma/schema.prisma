generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EquipmentStatus {
  available
  in_use    @map("in-use")
  broken
}

enum MessageStatus {
  read
  sent
  received
  unsent
}

// A room is either bookable or closed by staff; who has it when lives in RoomBooking
enum RoomStatus {
  available
  maintenance
}

enum TicketStatus {
  in_process @map("in-process")
  open
  closed
}

enum TicketKind {
  broken
  request
}

enum TicketEventType {
  created
  status_changed
  comment
}

enum NotificationType {
  reservation_expiring
  reservation_expired
  due_soon
  overdue
  ticket_updated
  ticket_reply
  announcement
  room_booking_soon
  room_booking_cancelled
}

model Admin {
  id       String  @id @default(cuid())
  email    String  @unique
  // Shown on history, loans and ticket replies so students and staff can see who acted
  name     String?
  password String?

  // Relations
  sessions              Session[]
  loansIssued           Loan[]             @relation("LoanIssuedBy")
  loansReturned         Loan[]             @relation("LoanReturnedTo")
  equipmentChanges      EquipmentHistory[]
  ticketEvents          TicketEvent[]
  announcements         Announcement[]
  roomBookingsCancelled RoomBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                        String    @id @default(cuid())
  username                  String    @unique
  achievements              String[]
  emailVerificationToken    String?
  emailVerificationExpires  DateTime?
  // Wrong guesses at the current code; the code is cancelled at MAX_CODE_ATTEMPTS
  emailVerificationAttempts Int       @default(0)
  isVerified                Boolean   @default(false)
  description               String?
  email                     String    @unique
  phone_number              String    @unique
  fullname                  String
  // Upper-case, set at sign-up and not editable: loans and borrowing blocks are kept by roll number
  roll_no                   String    @unique
  password                  String
  passwordResetToken        String?
  passwordResetExpires      DateTime?
  passwordResetAttempts     Int       @default(0)

  // Relations
  sessions           Session[]
  games              UserGameRating[]
  messagesSent       Message[]          @relation("MessagesSent")
  messagesReceived   Message[]          @relation("MessagesReceived")
  equipments         Equipment[]        @relation("EquipmentHolder")
  reservations       Equipment[]        @relation("EquipmentReservations")
  equipmentHistories EquipmentHistory[]
  tickets            Ticket[]
  ticketEvents       TicketEvent[]
  loans              Loan[]
  notifications      Notification[]
  roomBookings       RoomBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One signed-in browser or device. Its refresh token is stored hashed and replaced on every refresh.
// Signing out, changing or resetting the password, or replaying an old refresh token deletes the row,
// and access tokens stop working with it, so a session can be ended at once.
model Session {
  id        String   @id
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([adminId])
  @@index([expiresAt])
}

model UserGameRating {
  userId String
  gameId String
  rating Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

model Game {
  id   String @id @default(cuid())
  name String @unique

  // Relations
  users      UserGameRating[]
  equipments Equipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(cuid())
  heading     String
  content     String
  footer      String   @default("")
  expireAt    DateTime
  createdById String?
  createdBy   Admin?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Equipment {
  id       String          @id @default(cuid())
  name     String          @unique
  status   EquipmentStatus @default(available)
  // While the item is out: who has it and when it's due back. The full record is the open Loan.
  roll_no  String?
  issuedAt DateTime?
  dueAt    DateTime?

  // A student can hold a free item for a short time; the desk then lends it to them.
  // The hold is only live while reservedUntil is in the future; a job clears expired holds.
  reservedById          String?
  reservedBy            User?     @relation("EquipmentReservations", fields: [reservedById], references: [id], onDelete: SetNull)
  reservedUntil         DateTime?
  reservationRemindedAt DateTime?

  // Relations
  userId  String?
  user    User?              @relation("EquipmentHolder", fields: [userId], references: [id], onDelete: SetNull)
  games   Game[]
  history EquipmentHistory[]
  tickets Ticket[]
  loans   Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per status change, recording the state the item moved INTO and which staff member did it
model EquipmentHistory {
  id        String    @id @default(cuid())
  status    String
  roll_no   String?
  dueAt     DateTime?
  changedAt DateTime  @default(now())
  expireAt  DateTime

  // Relations
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  changedById String?
  changedBy   Admin?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId, changedAt])
}

model Message {
  id      String        @id @default(cuid())
  status  MessageStatus @default(unsent)
  content String

  // Relations
  senderId   String
  sender     User   @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User   @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id          String     @id @default(cuid())
  name        String     @unique
  capacity    Int        @default(0)
  description String?
  status      RoomStatus @default(available)

  bookings RoomBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A student's hold on a room for whole-hour slots. Cancelled bookings are kept for the record.
model RoomBooking {
  id                 String    @id @default(cuid())
  roomId             String
  room               Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt           DateTime
  endsAt             DateTime
  purpose            String?
  cancelledAt        DateTime?
  cancelledByAdminId String?
  cancelledByAdmin   Admin?    @relation(fields: [cancelledByAdminId], references: [id], onDelete: SetNull)
  reminderSentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, startsAt])
  @@index([userId, startsAt])
}

// One checkout of one item. Overdue tracking, late returns and busy-time analytics all read from here.
model Loan {
  id                String    @id @default(cuid())
  equipmentId       String
  equipment         Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  roll_no           String
  issuedAt          DateTime  @default(now())
  dueAt             DateTime
  returnedAt        DateTime?
  fromReservation   Boolean   @default(false)
  issuedById        String?
  issuedBy          Admin?    @relation("LoanIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  returnedToId      String?
  returnedTo        Admin?    @relation("LoanReturnedTo", fields: [returnedToId], references: [id], onDelete: SetNull)
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId, returnedAt])
  @@index([roll_no, issuedAt])
  @@index([returnedAt, dueAt])
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String
  // In-app path to open, e.g. /student/tickets
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Ticket {
  id            String       @id @default(cuid())
  kind          TicketKind   @default(broken)
  heading       String
  content       String
  status        TicketStatus @default(open)
  closedAt      DateTime?
  // For requests for new equipment
  requestedGame String?
  requestedItem String?

  // Relations
  equipmentId String?
  equipment   Equipment?    @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  senderId    String
  sender      User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  events      TicketEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The ticket's timeline: when it was opened, each status change, and replies from either side
model TicketEvent {
  id            String          @id @default(cuid())
  ticketId      String
  ticket        Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type          TicketEventType
  fromStatus    TicketStatus?
  toStatus      TicketStatus?
  body          String?
  authorUserId  String?
  authorUser    User?           @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAdminId String?
  authorAdmin   Admin?          @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
