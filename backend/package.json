{
  "name": "smart-sac-backend",
  "version": "1.0.0",
  "description": "Smart SAC API: equipment lending, reservations, rooms, tickets, chat and notifications",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src tests",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "author": "",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^9.47.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^7.8.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC"
}
