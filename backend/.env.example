PORT=8000
NODE_ENV="development"
# Comma-separated list of frontend origins allowed to call the API with cookies
CORS_ORIGIN="http://localhost:5173"
# Set to "true" when running behind a reverse proxy (nginx in docker-compose) so client IPs are right
TRUST_PROXY="false"

# Local PostgreSQL from ../docker-compose.yml (`npm run db:up`)
DATABASE_URL="postgresql://smartsac:smartsac@localhost:5432/smart_sac?schema=public"
# Database the test suite may wipe (`npm test`)
TEST_DATABASE_URL="postgresql://smartsac:smartsac@localhost:5432/smart_sac_test?schema=public"

# Generate each with: openssl rand -hex 32  (production refuses secrets shorter than 32 characters)
ACCESS_TOKEN_SECRET="change_me"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_SECRET="change_me_too"
REFRESH_TOKEN_EXPIRY="10d"

# Optional cookie policy overrides (defaults: Secure + SameSite=None in production, Lax in development)
# COOKIE_SECURE="true"
# COOKIE_SAMESITE="lax"

# Only these emails can be staff accounts (comma-separated). Removing one signs that account out.
ADMIN_EMAILS="desk@iiita.ac.in,office@iiita.ac.in"

# Email (Gmail needs an App Password). Leave blank in development: codes are printed in the log instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
# Receives new ticket emails
SPORTS_HEAD_EMAIL="sports_head@iiita.ac.in"

# The SAC's time zone: room slots, opening hours and busy-time charts follow it
APP_TIMEZONE="Asia/Kolkata"

# Optional
LOG_LEVEL="debug"
SENTRY_DSN=""
